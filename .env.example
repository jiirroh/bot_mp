# ==========================================
# CONFIGURATION DU BOT RELAIS MP (DISCORD.JS)
# ==========================================

# Jeton du bot Discord (fourni sur Discord Developer Portal)
DISCORD_TOKEN=votre_token_ici

# ID de l'application / client Discord
CLIENT_ID=votre_client_id_ici

# ID du serveur Discord principal
GUILD_ID=votre_guild_id_ici

# Salon du staff où les fils de discussion (threads) des tickets seront créés
STAFF_CHANNEL_ID=votre_staff_channel_id_ici

# Salon où les logs et transcripts des tickets fermés seront envoyés
LOG_CHANNEL_ID=votre_log_channel_id_ici

# Rôles autorisés à utiliser le bot (séparés par une virgule si plusieurs)
STAFF_ROLE_IDS=id_role_1,id_role_2

# Mode d'identité par défaut lors de la création d'un ticket ('anonymous' ou 'named')
DEFAULT_MODE=anonymous

# Message de réponse automatique envoyé aux membres qui écrivent au bot sans ticket ouvert
AUTO_REPLY_MESSAGE=Bonjour. Ce bot est exclusivement réservé aux messages initiés par l'équipe du serveur. Vous ne pouvez pas ouvrir de ticket par vous-même ici. Pour toute demande, merci de contacter le staff sur le serveur.

# Message envoyé au membre lors de la clôture d'un ticket
CLOSE_MESSAGE=Cette conversation a été clôturée par l'équipe. Vos nouveaux messages ne seront plus transmis. Merci pour votre échange.

# Chemin vers le fichier SQLite
DATABASE_PATH=./data/modmail.db
